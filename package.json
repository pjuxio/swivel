{
  "name": "swivel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env.local server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "server": "node --env-file-if-exists=.env.local server/index.js",
    "start": "npm run build && npm run server",
    "lint": "oxlint",
    "preview": "vite preview",
    "heroku-postbuild": "npm run build",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "22.x"
  }
}
