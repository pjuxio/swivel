# Copy to .env.local (gitignored) and fill in. Free key: https://developer.nlr.gov/signup/
NLR_API_KEY=
# PORT=3001
# Optional: require this shared password (any username) to open the app
# APP_PASSWORD=
# Contact email sent to Nominatim with geocoding requests (recommended by its usage policy)
# NOMINATIM_EMAIL=
# Proxy hops to trust for client IP and HTTPS detection. Defaults to 1 on Heroku and off elsewhere.
# TRUST_PROXY=1
# Redirect HTTP to HTTPS and send HSTS. Defaults to on when NODE_ENV=production and a proxy is trusted.
# FORCE_HTTPS=true
